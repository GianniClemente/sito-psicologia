---
import '../styles/global.css';

const {
  title = 'Dott. Gianni Clemente | Psicologo',
  description = 'Pagina personale del Dott. Gianni Clemente, psicologo.'
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a class="brand" href="#home">Dott. Gianni Clemente</a>

        <nav aria-label="Navigazione principale">
          <a href="#home">Home</a>
          <a href="#chi-sono">Chi sono</a>
          <a href="#tematiche">Tematiche</a>
          <a href="#libri">I miei libri</a>
          <a href="#contatti">Contatti</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        © {new Date().getFullYear()} Dott. Gianni Clemente · Psicologo
      </div>
    </footer>
  </body>
</html>
