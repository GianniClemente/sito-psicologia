---
import '../styles/global.css';

const {
  title = 'Dott. Gianni Clemente | Psicologo',
  description = 'Pagina personale del Dott. Gianni Clemente, psicologo.',
  canonical,
  noindex = false,
  ogType = 'website'
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://dottclemente.it');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteOrigin).toString();
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <title>{title}</title>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a class="brand" href="/">Dott. Gianni Clemente</a>

        <nav aria-label="Navigazione principale">
          <a href="/#home">Home</a>
          <a href="/#chi-sono">Chi sono</a>
          <a href="/#tematiche">Tematiche</a>
          <a href="/#libri">I miei libri</a>
          <a href="/#contatti">Contatti</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container footer-inner">
        <div>© {new Date().getFullYear()} Dott. Gianni Clemente · Psicologo</div>
        <nav class="footer-links" aria-label="Informazioni legali">
          <a href="/privacy/">Privacy</a>
          <a href="/cookie-policy/">Cookie</a>
          <a href="/disclaimer/">Disclaimer</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
