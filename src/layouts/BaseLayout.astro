---
import '../styles/global.css';

const {
  title = 'Dott. Gianni Clemente | Psicologo',
  description = 'Pagina personale del Dott. Gianni Clemente, psicologo.',
  canonical,
  noindex = false,
  ogType = 'website'
} = Astro.props;

const canonicalUrl = canonical || undefined;
const absoluteCanonical = canonicalUrl && /^https?:\/\//.test(canonicalUrl) ? canonicalUrl : undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {absoluteCanonical && <meta property="og:url" content={absoluteCanonical} />}

    <title>{title}</title>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a class="brand" href="/">Dott. Gianni Clemente</a>

        <nav aria-label="Navigazione principale">
          <a href="/#home">Home</a>
          <a href="/#chi-sono">Chi sono</a>
          <a href="/#tematiche">Tematiche</a>
          <a href="/#libri">I miei libri</a>
          <a href="/#contatti">Contatti</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        © {new Date().getFullYear()} Dott. Gianni Clemente · Psicologo
      </div>
    </footer>
  </body>
</html>
