---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dott. Gianni Clemente | Psicologo"
  description="Pagina personale del Dott. Gianni Clemente, psicologo. Ricerca in ambito psicoanalitico, interessi sui rapporti tra psicologia, religione, psicoanalisi e genetica."
>
  <section id="home" class="hero">
    <div class="container hub-intro" id="chi-sono">
      <div class="eyebrow">Chi sono</div>
      <h1>Dott. Gianni Clemente, psicologo.</h1>

      <p class="lead">
        Mi occupo principalmente di ricerca in campo psicoanalitico, con particolare
        interesse per i possibili punti di incontro tra psicologia, religione, psicoanalisi
        e genetica.
      </p>

      <p class="lead">
        In questo sito raccolgo contenuti, approfondimenti e materiali di psicologia
        legati ai miei principali interessi di studio e ricerca.
      </p>

      <a class="button" href="#tematiche">Esplora le tematiche</a>
    </div>
  </section>

  <section id="tematiche">
    <div class="container">
      <div class="eyebrow">Tematiche</div>
      <h2>Argomenti e approfondimenti.</h2>

      <div class="grid-3">
        <article class="card">
          <h3>Psicoanalisi</h3>
          <p>
            Teorie, concetti, autori e questioni di ricerca legate alla tradizione
            psicoanalitica e ai suoi sviluppi contemporanei.
          </p>
        </article>

        <article class="card">
          <h3>Psicologia e genetica</h3>
          <p>
            Riflessioni e approfondimenti sui rapporti tra fattori biologici,
            caratteristiche individuali, ambiente e sviluppo psicologico.
          </p>
        </article>

        <article class="card">
          <h3>Psicologia</h3>
          <p>
            Contenuti divulgativi e approfondimenti su temi psicologici di interesse
            scientifico e culturale.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="libri">
    <div class="container">
      <div class="eyebrow">I miei libri</div>
      <h2>Pubblicazioni.</h2>
      <p class="lead">
        In questa sezione raccoglierò i miei libri e le pubblicazioni, con una breve
        presentazione dei contenuti e i relativi riferimenti.
      </p>

      <div class="grid-3">
        <article class="card">
          <h3>Titolo del libro</h3>
          <p>
            Breve descrizione del volume. Potremo aggiungere copertina, anno di
            pubblicazione, editore e collegamento alla scheda del libro.
          </p>
        </article>

        <article class="card">
          <h3>Titolo del libro</h3>
          <p>
            Spazio predisposto per una seconda pubblicazione o per un futuro volume.
          </p>
        </article>

        <article class="card">
          <h3>Altre pubblicazioni</h3>
          <p>
            Qui potremo raccogliere articoli, contributi, materiali o altri lavori
            di interesse.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="contatti">
    <div class="container">
      <div class="eyebrow">Contatti</div>
      <h2>Contatti professionali.</h2>
      <p class="lead">
        Per comunicazioni relative ai contenuti del sito, alla ricerca o alle
        pubblicazioni sarà possibile utilizzare i recapiti indicati in questa sezione.
      </p>
      <p class="meta">
        I contatti presenti sul sito non sono destinati alla richiesta di prestazioni
        psicologiche o alla prenotazione di colloqui clinici.
      </p>
    </div>
  </section>
</BaseLayout>
